# Render sets PORT automatically — you usually don't need to set this yourself.
PORT=4000

# Comma-separated list of allowed frontend origins (your Vercel URL(s)).
# Use "*" only for quick testing — lock this down before going live.
CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:5173

# Pulse — the in-app assistant.
# Default: a LOCAL engine (Ollama, llama3:latest) that GRIDPULSE installs and
# starts automatically on first launch — no API key, terminal commands or .env
# edits needed. Leave the block below commented in a normal install.
# Choose the provider explicitly:
#   ollama (default)  auto-provisions a private local engine
#   cloud             any OpenAI-compatible provider (bring your own key)
#   off               disable the AI assistant
# GRIDPULSE_AI_PROVIDER=ollama
# GRIDPULSE_AI_API_KEY=sk-…
# GRIDPULSE_AI_BASE_URL=https://api.openai.com/v1
# GRIDPULSE_AI_MODEL=gpt-4o-mini

# PRISM trace ingest (set to enable tracing to the PRISM content API).
# Only these three variables are used — a project ID and ingest key are
# required; without them tracing is skipped and the chat behaves normally.
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=
