# Render sets PORT automatically — you usually don't need to set this yourself.
PORT=4000

# Comma-separated list of allowed frontend origins (your Vercel URL(s)).
# Use "*" only for quick testing — lock this down before going live.
CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:5173

# Assistant AI (optional) — the in-app chatbot uses any OpenAI-compatible
# provider. Without a key it falls back to offline knowledge mode.
# GRIDPULSE_AI_API_KEY=sk-…
# GRIDPULSE_AI_BASE_URL=https://api.openai.com/v1
# GRIDPULSE_AI_MODEL=gpt-4o-mini

# PRISM (Block Convey) — AI observability & evaluation for the assistant.
# Every chat exchange is traced (fire-and-forget), scored, and grouped by
# session. Set these to start tracing; without a key or project the
# assistant keeps working but no traces are sent.
# PRISMTRACE_HOST=https://prism.blockconvey.com
# PRISMTRACE_PROJECT_ID=00000000-0000-0000-0000-000000000000
# PRISMTRACE_API_KEY=pt-sk-…
