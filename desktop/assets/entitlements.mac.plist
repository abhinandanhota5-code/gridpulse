<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required for Electron's V8 JIT under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Allow loading Electron/Chromium frameworks without re-signing. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The app does not need outgoing network connections to be secured, but
         this entitlement is often included to be explicit for notarization. -->
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
